{
  "name": "estate-agent-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://hansanaweerakkody.github.io/estate-agent-app",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:vercel": "vercel --prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest src/test/security.test.js --verbose",
    "test:csp": "jest --testNamePattern=\"CSP\" src/test/security.test.js --verbose",
    "test:jsx": "jest --testNamePattern=\"JSX\" src/test/security.test.js --verbose",
    "test:integration": "jest --testNamePattern=\"Integration\" src/test/security.test.js --verbose",
    "test:escape": "jest --testNamePattern=\"escapeHTML\" src/test/security.test.js",
    "test:sanitize": "jest --testNamePattern=\"sanitizeHTML\" src/test/security.test.js",
    "test:validate": "jest --testNamePattern=\"validate\" src/test/security.test.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "analyze": "source-map-explorer 'dist/assets/*.js'",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "clean": "rm -rf dist node_modules/.cache",
    "serve": "serve -s dist",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "dompurify": "^3.0.6",
    "react": "^18.2.0",
    "react-datepicker": "^4.21.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.8.0",
    "react-tabs": "^6.1.0",
    "react-widgets": "^5.8.4",
    "axios": "^1.6.0",
    "classnames": "^2.5.1",
    "prop-types": "^15.8.1",
    "lodash": "^4.17.21",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-security": "^2.1.0",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.4",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.3.3",
    "vite": "^7.2.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-checker": "^0.6.3",
    "vite-plugin-pwa": "^0.17.4",
    "vite-plugin-mkcert": "^1.17.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/src/test/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/test/**/*",
      "!src/index.js",
      "!src/reportWebVitals.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "real-estate",
    "property-search",
    "react",
    "vite",
    "estate-agent"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/estate-agent-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/estate-agent-app/issues"
  }
}