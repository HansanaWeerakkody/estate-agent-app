{
  "name": "estate-agent-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest src/utils/security.test.js --verbose",
    "test:csp": "jest --testNamePattern=\"CSP\" src/utils/security.test.js --verbose",
    "test:jsx": "jest --testNamePattern=\"JSX\" src/utils/security.test.js --verbose",
    "test:integration": "jest --testNamePattern=\"Integration\" src/utils/security.test.js --verbose",
    "test:escape": "jest --testNamePattern=\"escapeHTML\" src/utils/security.test.js",
    "test:sanitize": "jest --testNamePattern=\"sanitizeHTML\" src/utils/security.test.js",
    "test:validate": "jest --testNamePattern=\"validate\" src/utils/security.test.js"
  },
  "dependencies": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "dompurify": "^3.0.6",
    "react": "^18.2.0",
    "react-datepicker": "^4.21.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.8.0",
    "react-tabs": "^6.1.0",
    "react-widgets": "^5.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-jest": "^29.7.0",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^7.2.4"
  }
}
